function checkKokushi(tiles) {
 const yaochuSet = new Set(['1m', '9m', '1p', '9p', '1s', '9s', '1z', '2z', '3z', '4z', '5z', '6z', '7z']);
 const uniqueTiles = new Set(tiles);

 if (uniqueTiles.length !== 13) {
 return false;
 }

 let matchingTiles = 0;
 for (let tile of uniqueTiles) {
 if (yaochuSet.has(tile)) {
 matchingTiles++;
 }
 }

 return matchingTiles === 13;
}
